DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=marketplaceos
DB_PORT=3306

PORT=5000

# Required: a strong secret (>=32 chars) used to sign access JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS: comma-separated list of allowed origins (no spaces).
# e.g. https://marketplaceos.example.com,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Access token lifetime (seconds). Default 900 (15 min).
JWT_ACCESS_EXPIRES_IN=900

# Refresh token lifetime (seconds). Default 604800 (7 days).
JWT_REFRESH_EXPIRES_IN=604800

# In-memory rate limit: max requests per window per IP for auth endpoints.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=900

# In-memory rate limit: max general requests per window per IP.
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW=900

# Absolute path for uploaded product images.
UPLOAD_DIR=
