DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=marketplaceos
DB_PORT=3306

# Set DB_SSL=true when the database is a managed host reached over the public
# internet (Aiven, PlanetScale, Railway, ...). Leave unset for local MySQL.
DB_SSL=false
# Only set true if the provider's certificate chains to a publicly trusted CA.
DB_SSL_REJECT_UNAUTHORIZED=false

PORT=5000

# Required: a strong secret (>=32 chars) used to sign access JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS: comma-separated list of allowed origins (no spaces).
# e.g. https://marketplaceos.example.com,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Access token lifetime (seconds). Default 900 (15 min).
JWT_ACCESS_EXPIRES_IN=900

# Refresh token lifetime (seconds). Default 604800 (7 days).
JWT_REFRESH_EXPIRES_IN=604800

# In-memory rate limit: max requests per window per IP for auth endpoints.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=900

# In-memory rate limit: max general requests per window per IP.
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW=900

# Absolute path for uploaded product images.
UPLOAD_DIR=

# Absolute path to the built SPA that Express should serve (single-host deploy).
# Defaults to ../frontend/dist relative to backend/; ignored if the folder is absent.
FRONTEND_DIST=

# When "true", the server applies the schema on boot and seeds demo data if the
# database is empty. Intended for hosts with no shell (Render free tier), where
# `npm run db:migrate` cannot be run by hand. Opt out by setting it to "false".
AUTO_MIGRATE=false
